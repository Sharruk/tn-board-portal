# ==============================================================================
# Hungry Learner / TN Board Portal — Unified Environment Variables Template
# ==============================================================================
# This template documents all environment variables required by the platform.
#
# LOCAL DOCKER DEVELOPMENT:
#   - Docker Compose reads from `.env` at the root, or cascades to:
#     - `backend/.env` for backend service configuration
#     - `frontend/.env.local` for frontend Vite build configuration
#
# SECURITY RULES:
#   - NEVER commit real `.env` or `.env.local` files to Git.
#   - NEVER prefix backend secrets (service role keys, service accounts) with `VITE_`.
#   - Variables prefixed with `VITE_` are compiled into the client-side JavaScript bundle!
# ==============================================================================

# ==============================================================================
# 1. BACKEND & DATABASE CONFIGURATION (backend/.env or root .env)
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Supabase Project API URL & Keys
# Obtain from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (STRICTLY CONFIDENTIAL — Server-Side Only)
# Bypasses Row Level Security (RLS) for administrative operations and Storage deletion
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Direct PostgreSQL Database Connection URL (Session Pooler port 5432)
# Obtain from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Allowed CORS Origins (comma-separated list without trailing slashes)
# In production, include your Vercel deployment URL
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5000,http://127.0.0.1:5173,https://tn-board-portal.vercel.app

# Firebase Admin Authentication
# Local development option: Relative or absolute path to service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json
# Production / Vercel option: Full JSON string content of the service account
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"tn-board-portal",...}'

# Primary Authorized Super Admin Google Email
ADMIN_EMAIL=hungrylearner786@gmail.com

# Backend Self-Reference (used for internal redirects / docs)
BACKEND_URL=http://localhost:8000


# ==============================================================================
# 2. FRONTEND CLIENT CONFIGURATION (frontend/.env.local or root .env)
# ==============================================================================

# Supabase Client Credentials (Public / RLS Enforced)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Firebase Web App Client SDK Configuration
# Obtain from: Firebase Console → Project Settings → General → Web Apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-app-id:web:your-app-hash
VITE_FIREBASE_MEASUREMENT_ID=G-YOURMEASUREMENTID

# API Reverse Proxy Target (for Vite dev server inside Docker)
# Inside Docker Compose, this points to the backend service name `http://backend:8000`
# For local standalone Vite outside Docker, defaults to `http://127.0.0.1:8000`
VITE_API_PROXY_TARGET=http://backend:8000

# Base URL Prefix for FastAPI Client
# Leave empty string in local development (proxied by Vite) and Vercel unified deployment
VITE_API_BASE_URL=
