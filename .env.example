# =======================================================================
# TN State Board Learning Platform — Environment Variables
# =======================================================================
#
# Copy this file to .env and fill in the real values before running.
# NEVER commit .env to version control.
#
# Required variables are marked  [REQUIRED]
# Optional variables are marked  [OPTIONAL] with their defaults shown
# =======================================================================


# ── Application ─────────────────────────────────────────────────────────────

# Runtime environment. Controls docs visibility, debug behaviour, etc.
# Values: development | production
# [OPTIONAL] default: development
ENVIRONMENT=production


# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Replit provides this automatically via the built-in PostgreSQL integration.
# [REQUIRED]
DATABASE_URL=postgresql://user:password@localhost:5432/tnboard


# ── Authentication ────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWT access tokens.
# MUST be a long, random, unpredictable string in production.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# [REQUIRED]
JWT_SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_here

# JWT token expiry in minutes.
# [OPTIONAL] default: 60
JWT_EXPIRE_MINUTES=60


# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins.
# In development you can use *.
# In production, set this to the exact frontend URL(s).
# Example: https://tnboard.example.com,https://www.tnboard.example.com
# [REQUIRED in production]
CORS_ORIGINS=https://your-frontend-domain.replit.app


# ── File Storage ──────────────────────────────────────────────────────────────

# Storage provider for uploaded PDF files.
# Values: local | s3 | supabase
# WARNING: "local" storage is not durable on Replit's managed VMs.
#          Switch to s3 or supabase for production.
# [OPTIONAL] default: local
STORAGE_BACKEND=local

# ── AWS S3 (required when STORAGE_BACKEND=s3) ────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=tnboard-uploads
# AWS_S3_REGION=ap-south-1

# ── Supabase Storage (required when STORAGE_BACKEND=supabase) ────────────────
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=papers


# ── Frontend (build-time only, Vite) ──────────────────────────────────────────

# Base URL of the FastAPI backend used by the React frontend.
# Only required for Option A deployment (Vercel frontend + Railway backend).
# For Option B (single deployment), leave this unset — defaults to /api/v1.
# [OPTIONAL] default: /api/v1
# VITE_API_URL=https://your-backend.up.railway.app/api/v1
