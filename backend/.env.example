# ======================================================================
# TN Board Portal — Backend Environment Variables
# ======================================================================
#
# Copy this file to backend/.env and fill in the real values.
# NEVER commit .env to version control — it is in .gitignore.
#
# Values are read by app/config/settings.py via pydantic-settings.
# ======================================================================

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────

# Runtime environment: development | staging | production
ENVIRONMENT=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Set to true only in development for auto-reload and verbose errors
DEBUG=false

# ──────────────────────────────────────────────
# Supabase
# Get these from: Supabase Dashboard → Settings → API
# ──────────────────────────────────────────────

# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (safe for read operations protected by RLS)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (bypasses RLS — admin operations only)
# Leave empty if not needed. NEVER expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────
# CORS — Allowed frontend origins
# Comma-separated list, no trailing slashes.
# ──────────────────────────────────────────────

# Local development + Vercel production + future Render backend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://tn-board-portal.vercel.app

# ──────────────────────────────────────────────
# Firebase Authentication
# ──────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json

# ──────────────────────────────────────────────
# Backend self-reference
# Used for inter-service calls if needed in future sprints.
# ──────────────────────────────────────────────
BACKEND_URL=https://your-service-name.onrender.com
