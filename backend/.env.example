# ======================================================================
# TN Board Portal — Backend Environment Variables Template
# ======================================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env to version control — it is ignored in .gitignore.
#
# Values are loaded by app/config/settings.py via pydantic-settings.
# ======================================================================

# ──────────────────────────────────────────────
# Application & Logging
# ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
APP_NAME="TN Board Portal API"
APP_VERSION="2.0.0"

# ──────────────────────────────────────────────
# Supabase & PostgreSQL Connection
# ──────────────────────────────────────────────
# Obtain from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role key (bypasses RLS — admin operations & outbox storage cleanup)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Direct PostgreSQL Database Connection URL (Session Pooler port 5432)
# Obtain from Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# ──────────────────────────────────────────────
# CORS Configuration
# ──────────────────────────────────────────────
# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5000,http://127.0.0.1:5173,https://tn-board-portal.vercel.app

# ──────────────────────────────────────────────
# Firebase Authentication
# ──────────────────────────────────────────────
# Local development option: path to service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=backend/secrets/firebase-service-account.json
# Production / Serverless option: full JSON string content
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Primary Authorized Super Admin Google Email
ADMIN_EMAIL=hungrylearner786@gmail.com

# Backend self-reference
BACKEND_URL=http://localhost:8000
